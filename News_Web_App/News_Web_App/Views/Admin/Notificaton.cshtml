@using News_Models.Extenssions
@using News_Models.Model
@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<object>

@{
    ViewData["Title"] = "الإشعارات";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<main class="app-main" dir="rtl">
    <!-- العنوان والفلتر -->
    <div class="app-content-header py-4 border-bottom mb-4 bg-white shadow-sm rounded">
        <div class="container-fluid">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">

                <!-- العنوان -->
                <h3 class="text-primary d-flex align-items-center mb-0">
                    <i class="bi bi-bell-fill fs-4 me-2"></i> كل الإشعارات
                </h3>

                <!-- الأزرار والفلاتر -->
                <div class="d-flex flex-wrap align-items-center gap-2">

                    <a href="/Admin/Notificaton" class="btn btn-outline-secondary">
                        <i class="bi bi-list-ul me-1"></i> عرض الكل
                    </a>

                    <a href="/Admin/Notificaton?filter=comments" class="btn btn-outline-primary">
                        <i class="bi bi-chat-left-text me-1"></i> التعليقات
                    </a>

                    <a href="/Admin/Notificaton?filter=messages" class="btn btn-outline-success">
                        <i class="bi bi-envelope me-1"></i> الرسائل
                    </a>

                    <select class="form-select border-primary shadow-sm" style="min-width: 100px;" id="filter">
                        <option value="">فلتر الحالة</option>
                        <option value="read">مقروء</option>
                        <option value="unread">غير مقروء</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- الإشعارات -->
    <div class="container-fluid">
        <div id="notificationList">
            @foreach (var notification in Model)
            {
                string id = "";
                string statusClass = "";
                string status = "";
                string title = "";
                string content = "";
                string link = "";
                string iconClass = "";
                string created = "";
                bool isMessage = false;
                if (notification is Comment comment)
                {
                    id = comment.Id.ToString();
                    isMessage  =  true;
                    status = comment.Status.ToString().ToLower();
                    statusClass = comment.Status == MessageStatus.UnRead ? "border-danger bg-light" : "border-success";
                    title = $"تعليق جديد من {comment.Author}";
                    content = comment.Content;
                    link = $"/Home/Details/{comment.NewsId}#comment-{comment.Id}";
                    iconClass = "bi-chat-dots";
                    created = comment.CreatedAt.TimeAgo();
                }
                else if (notification is Message message)
                {
                    id = message.Id.ToString();
                    isMessage = false;
                    status = message.Status.ToString().ToLower();
                    statusClass = message.Status == MessageStatus.UnRead ? "border-danger bg-light" : "border-success";
                    title = $"رسالة من {message.Name}";
                    content = message.Content;
                    link = $"/Admin/MessageDetails/{message.Id}";
                    iconClass = "bi-envelope";
                    created = message.CreatedAt.TimeAgo();
                }

                <div class="notification-card p-3 mb-3 rounded shadow-sm border @statusClass" data-status="@status" id="@id">
                    <div class="d-flex justify-content-between align-items-start flex-row-reverse">
                        <div class="d-flex flex-column align-items-center">
                            <small class="text-muted mt-1 mb-2"><i class="bi bi-clock ms-1"></i> @created</small>
                            @if (!isMessage)
                            {
                                <div class="btn-group">
                                    <a asp-action="MessageEdit" asp-route-id="@id" class="btn btn-sm btn-primary" data-bs-toggle="tooltip" title="تعديل">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button class="btn btn-danger btn-sm delete-btn" data-bs-toggle="tooltip" title="حذف" onclick="DeleteItem('/Admin/RemoveMessage/@id', '@id')">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                    <a href="#" class="btn btn-sm btn-warning btn-archive" data-bs-toggle="tooltip" title="أرشفة" data-id="@id">
                                        <i class="fas fa-archive"></i>
                                    </a>
                                    <a href="#" class="btn btn-sm btn-success btn-reply" data-bs-toggle="tooltip" title="الرد" data-id="@id">
                                        <i class="fas fa-reply"></i>
                                    </a>

                                </div>
                            }
                            else
                            {
                                <div class="btn-group">
                                    <a asp-action="ViewComment" asp-route-id="@id" class="btn btn-sm btn-primary" data-bs-toggle="tooltip" title="تعديل">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button class="btn btn-danger btn-sm delete-btn" data-bs-toggle="tooltip" title="حذف" onclick="DeleteItem('/Home/RemoveComment/@id', '@id')">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                            }
                        </div>
                        <div class="d-flex align-items-center flex-row-reverse">
                            <div>
                                <h6 class="mb-1 text-dark"><i class="bi @iconClass me-1 text-primary"></i> @title</h6>
                                <p class="mb-1 text-muted small">@content</p>
                                <a href="@link" class="text-primary small">عرض التفاصيل <i class="bi bi-box-arrow-up-left"></i></a>
                            </div>
                            <img src="~/img/icons8-user-64.png" alt="User" class="rounded-circle ms-3" style="width: 50px; height: 50px;">
                        </div>
                    </div>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="alert alert-info text-center mt-4">
                    لا توجد إشعارات حالياً.
                </div>
            }
        </div>

        <!-- Pagination -->
        <div id="pagination" class="d-flex justify-content-center mt-4">

            @Html.PagedListPager(Model, page => Url.Action("Notificaton", new { Page = page }),
                     new PagedListRenderOptions
            {
                LiElementClasses = new string[] { "page-item" },
                PageClasses = new string[] { "page-link" },
                UlElementClasses = new string[] { "pagination" }
            })
        </div>
    </div>
</main>

@section Scripts {

    <!-- SweetAlert2 CSS -->
    <script>


        // زر الأرشيف
        $('.btn-archive').click(function(e) {
            e.preventDefault();
            var messageId = $(this).data('id');
            Swal.fire({
                title: 'هل أنت متأكد؟',
                text: "هل تريد أرشفة هذه الرسالة؟",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'نعم، أرشفها!',
                cancelButtonText: 'إلغاء'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Archive", "Admin")',
                        type: 'POST',
                        data: { id: messageId },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire('تم!', 'تم أرشفة الرسالة بنجاح.', 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('خطأ!', 'فشل أرشفة الرسالة.', 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('خطأ!', 'حدث خطأ أثناء أرشفة الرسالة.', 'error');
                        }
                    });
                }
            });
        });
        document.getElementById('filter').addEventListener('change', function () {
            var filterValue = this.value;
            // تغيير الرابط بناءً على الاختيار
            window.location.href = '@Url.Action("Notificaton", "Admin")?status=' + filterValue;
        });
        // Function to delete a notification
        function DeleteItem(url, id) {
            Swal.fire({
                title: "هل أنت متأكد؟",
                text: "لن تتمكن من التراجع عن هذا!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "نعم، احذفها!"
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: url,
                        type: "DELETE",
                        success: function (data) {
                            if (data.success) {
                                toastr.success(data.message, "نجاح", {
                                    closeButton: true,
                                    progressBar: true,
                                    positionClass: "toast-top-right",
                                    timeOut: 5000
                                });
                                    $('#' + id).remove();
                                    } else {
                                toastr.error(data.message, "خطأ", {
                                    closeButton: true,
                                    progressBar: true,
                                    positionClass: "toast-top-right",
                                    timeOut: 5000
                                });
                            }
                        },
                        error: function () {
                            toastr.error("حدث خطأ أثناء حذف الخبر.", "خطأ", {
                                closeButton: true,
                                progressBar: true,
                                positionClass: "toast-top-right",
                                timeOut: 5000
                            });
                        }
                    });
                }
            });
        }


                // زر الرد
        $('.btn-reply').click(function(e) {
            e.preventDefault();
            var messageId = $(this).data('id');  // جلب ID الرسالة
            console.log(messageId);
            Swal.fire({
                title: 'الرد على الرسالة',
                input: 'textarea',
                inputPlaceholder: '...اكتب ردك هنا',
                showCancelButton: true,
                confirmButtonText: 'إرسال',
                cancelButtonText: 'إلغاء',
                showLoaderOnConfirm: true,
                preConfirm: (reply) => {
                    if (!reply) {
                        Swal.showValidationMessage('الرد لا يمكن أن يكون فارغًا');
                    }
                    return reply;
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Admin/Reply',  // تأكد من صحة هذا الرابط
                        type: 'POST',
                        data: { id: messageId, replyContent: result.value },  // تمرير الـ ID والرد
                        success: function(response) {
                            if (response.success) {
                                Swal.fire('تم!', 'تم إرسال الرد بنجاح.', 'success').then(() => {
                                    location.reload();  // إعادة تحميل الصفحة بعد الرد
                                });
                            } else {
                                Swal.fire('خطأ!', 'فشل إرسال الرد.', 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('خطأ!', 'حدث خطأ أثناء إرسال الرد.', 'error');
                        }
                    });
                }
            });
        });

    </script>
}

<style>
    .notification-card {
        transition: 0.3s ease-in-out;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

        .notification-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
        }

    #pagination button {
        margin: 0 10px;
        font-size: 16px;
    }

    .btn-group {
        display: flex;
        gap: 8px;
    }
</style>
